# PHPStan Configuration for Laravel
# Suppressing false positives for Eloquent Builder methods and Laravel-specific patterns

parameters:
    level: 5
    paths:
        - app
        - bootstrap
        - config
        - database
        - routes
        - tests
    treatPhpDocTypesAsCertain: false
    typeAliases:
        Builder: Illuminate\Database\Eloquent\Builder

[phpstan]
ignoreErrors:
    # Eloquent Builder method signature mismatches (false positives)
    - '#Not enough arguments#'
    - '#Too many arguments#'
    - '#Unexpected token#'
    - '#Call to an undefined method#'
    - '#Access to undefined constant#'
    - message: '#Parameters of overridden method#'
      path: '*'
    # Filament-specific
    - '#Static method.*::make#'
    - '#Method.*::where#'
    - '#Method.*::whereYear#'
    - '#Method.*::whereMonth#'
    - '#Method.*::whereIn#'
    - '#Method.*::whereNotNull#'
    - '#Method.*::count#'
