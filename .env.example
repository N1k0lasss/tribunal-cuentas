APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=bcrypt

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tribunal_cuentas
DB_USERNAME=root
DB_PASSWORD=

LEGAJOS_DB_HOST=127.0.0.1
LEGAJOS_DB_PORT=3306
LEGAJOS_DB_DATABASE=legajos
LEGAJOS_DB_USERNAME=root
LEGAJOS_DB_PASSWORD=

LEGAJOS_API_URL=https://10.0.7.6/api
LEGAJOS_API_TOKEN=
LEGAJOS_API_VERIFY_SSL=false
LEGAJOS_API_TIMEOUT=15
LEGAJOS_API_RETRIES=2

SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Recuperación por SMS deshabilitada hasta una futura implementación.
PASSWORD_RECOVERY_SMS_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API del Sistema de Legajos (integracion-legajos-api.md)
LEGAJOS_API_URL=
LEGAJOS_API_TOKEN=
LEGAJOS_API_VERIFY_SSL=true
LEGAJOS_API_TIMEOUT=10
LEGAJOS_API_CONNECT_TIMEOUT=3

# Envío de licencias aprobadas (outbox + job en cola)
LEGAJOS_ENVIO_QUEUE=legajos
LEGAJOS_ENVIO_TRIES=5
LEGAJOS_ENVIO_TIMEOUT=30
LEGAJOS_ENVIO_UNIQUE_FOR=7200
